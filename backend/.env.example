# Copy this file to .env. Local sign-in is disabled unless you enable it below.
BOOKLOOM_AUTH_ENABLED=false
BOOKLOOM_PASSWORD=change-this-to-a-12-character-local-password
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/booklist
